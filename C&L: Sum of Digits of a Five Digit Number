#include <stdio.h>
#include <string.h>
#include <math.h>
#include <stdlib.h>
int sumdigit(int n){
    
    int sum[5];
    for(int i=4; i>=0; --i){
        sum[i] = n%10;
        n/=10;
        
    }
    int addi = 0;
    for(int i=0; i<5; i++){
        addi += sum[i];
        
    }
    printf("%d", addi);
    
    return 0;
}

int main() {
	
    int n;
    scanf("%d", &n);
    sumdigit(n);
    return 0;
}
