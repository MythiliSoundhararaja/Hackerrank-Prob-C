#include <stdio.h>

typedef struct complexnumber{
    int real;
    int img;
}complex;

complex add(complex a, complex b);

int main(){
    complex a, b, sum;
    
    a.real = 9;
    a.img = 8;
    
    b.real = 1;
    b.img = 2;
    
    printf("a = %d + %di\n", a.real, a.img);
    printf("b = %d + %di\n", b.real, b.img);
    sum = add(a, b);
    
    printf("sum = %d + %di", sum.real, sum.img);
    
    return 0;
    
}

complex add(complex a, complex b){
    complex add;
    
    add.real = a.real+b.real;
    add.img = a.img+b.img;
    
    return (add);
}
