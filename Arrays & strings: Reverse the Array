#include <stdio.h>
#include <stdlib.h>

int reversearr(int n, int arr[n]){
    int term;
    for(int start=0, end=n-1; start<end; start++, end--){
        term = arr[start];
        arr[start] = arr[end];
        arr[end] = term;
    }
    
    for(int i=0; i<n; i++){
        printf("%d\t", arr[i]);
    }
    return 0;
    
}

int main(){
    int n;
    scanf("%d", &n);
    
    int arr[n];
    
    for(int i=0; i<n; i++){
        scanf("%d", &arr[i]);
    }
    
    reversearr(n, arr);
    
    return 0;
}
