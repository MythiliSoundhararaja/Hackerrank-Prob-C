#include <stdio.h>

int Primeornot(int n){
    int flag;
    if(n == 1| n == 0){
        flag = 1;
    }
    
    for(int i=2; i<n/2; i++){
        if(n%i == 0){
            flag = 1;
        }
    }
    
    if(flag == 0){
        printf("Prime number");
    }
    else{
        printf("Not a prime number");
    }
    return 0;
}

int main()
{
    int n;
    printf("enter a number: ");
    scanf("%d", &n);
    
    Primeornot(n);
    
    return 0;
    
}
