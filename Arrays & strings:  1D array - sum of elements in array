#include <stdio.h>
#include <string.h>
#include <math.h>
#include <stdlib.h>
int sumarr(int n, int arr[n]){
    int sum = 0;
    for(int i=0; i<n; i++){
        sum+=arr[i];
    }
    printf("%d", sum);
    
    return sum; 
}


int main() {
    int n; 
    scanf("%d", &n);
    
    int arr[n];
    for(int i=0; i<n; i++){
        scanf("%d", &arr[i]);
    }
    sumarr(n, arr);
  /* Enter your code here. Read input from STDIN. Print output to STDOUT */    
